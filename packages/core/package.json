{
  "name": "@env-lane/core",
  "version": "0.4.0",
  "type": "module",
  "description": "Core dotenv injection, workspace resolution, selector checks, and env sorting for env-lane.",
  "license": "MIT",
  "author": "billstark001",
  "homepage": "https://github.com/billstark001/env-lane#readme",
  "bugs": {
    "url": "https://github.com/billstark001/env-lane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billstark001/env-lane.git",
    "directory": "packages/core"
  },
  "keywords": [
    "dotenv",
    "env",
    "environment",
    "workspace",
    "pnpm",
    "secrets"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./env-document": {
      "types": "./dist/env-document.d.ts",
      "import": "./dist/env-document.js",
      "require": "./dist/env-document.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/env-document.ts --format esm,cjs --clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "c12": "^3.3.4",
    "dotenv": "^17.4.2",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "find-up": "^8.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
