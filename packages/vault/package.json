{
  "name": "@env-lane/vault",
  "version": "0.1.0",
  "type": "module",
  "description": "Unsafe-by-default development vault record storage for env-lane dotenv files.",
  "license": "MIT",
  "author": "billstark001",
  "homepage": "https://github.com/billstark001/env-lane#readme",
  "bugs": {
    "url": "https://github.com/billstark001/env-lane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billstark001/env-lane.git",
    "directory": "packages/vault"
  },
  "keywords": [
    "dotenv",
    "env",
    "vault",
    "development",
    "secrets",
    "workspace"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "c12": "^3.3.4",
    "dotenv": "^17.4.2",
    "picomatch": "^4.0.4",
    "zod": "^4.4.3"
  }
}
