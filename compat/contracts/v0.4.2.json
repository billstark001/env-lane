    "migrationRule": "Preserve in the Node facade for the documented 0.4.x window; do not add Rust public surface solely for these names. A Rust primitive may exist only when needed by a stable workflow or persisted protocol."
  },
  "cli": {
    "binary": "env-lane",
    "globalOptions": [
      "-V, --version",
      "-c, --config <file>",
      "-b, --build <name>",
      "--cwd <dir>",
      "--format <format>",
      "--json",
      "--non-interactive",
      "--no-prefix",
      "-h, --help"
    ],
    "commands": [
      { "name": "packages", "owner": "native-cli", "args": [], "options": [] },
      { "name": "resolve-target", "owner": "native-cli", "args": ["<target>"], "options": [] },
      {
        "name": "files",
        "aliases": ["env-files"],
        "owner": "native-cli",
        "args": ["[target]"],
        "options": ["--require-override"]
      },
      {
        "name": "print",
        "aliases": ["env-json"],
        "owner": "native-cli",
        "args": ["<target>"],
        "options": ["--show-secrets", "--include-shell", "--no-process-env"]
      },
      {
        "name": "run",
        "owner": "native-cli",
        "args": ["<target>", "<command...>"],
        "options": ["--run-cwd <target|root|path>", "--quiet"],
        "childBoundary": "explicit -- or first non-option after target; all later child options are opaque"
      },
      {
        "name": "check",
        "owner": "native-cli",
        "args": [],
        "options": ["--policy <name>", "--target <target>", "--require-override"]
      },
      {
        "name": "sync",
        "owner": "native-cli",
        "args": ["<name>"],
        "options": ["--dry-run", "--show-secrets"]
      },
      {
        "name": "sort-file",
        "owner": "native-cli",
        "args": ["<envFile>", "<templateFile>"],
        "options": ["--check", "--eol <format>", "--no-preserve-bom"]
      },
      {
        "name": "sort",
        "owner": "native-cli",
        "args": ["[key]", "[envSuffix]"],
        "defaults": ["all", "all"],
        "options": ["--check", "--eol <format>", "--no-preserve-bom"]
      },
      {
        "name": "vault encrypt",
        "owner": "native-cli",
        "args": ["<keyFile>"],
        "options": [
          "--dry-run",
          "--sync-dir <dir>",
          "--vault-config <file>",
          "--no-auto-remap",
          "--missing-files <mode>",
          "--conflicts <mode>",
          "--file <glob>",
          "--key <glob>",
          "--include <glob>",
          "--exclude <glob>",
          "--only <actions>",
          "--approve-deletes",
          "--no-approve-deletes",
          "--fail-on <condition>"
        ]
      },
      {
        "name": "vault plan",
        "owner": "native-cli",
        "args": ["<keyFile>"],
        "options": [
          "--output <file>",
          "--sync-dir <dir>",
          "--vault-config <file>",
          "--no-auto-remap",
          "--allow-unmanaged",
          "--redaction <mode>",
          "--reveal <start:end>",
          "--no-reveal",
          "--file <glob>",
          "--key <glob>",
          "--include <glob>",
          "--exclude <glob>",
          "--only <actions>",
          "--approve-deletes",
          "--no-approve-deletes",
          "--fail-on <condition>"
        ]
      },
      {
        "name": "vault decrypt",
        "owner": "native-cli",
        "args": ["<keyFile>"],
        "options": [
          "--dry-run",
          "-y, --yes",
          "--sync-dir <dir>",
          "--vault-config <file>",
          "--no-auto-remap",
          "--allow-unmanaged",
          "--prompt-loop",
          "--no-prompt-loop",
          "--conflicts <mode>",
          "--redaction <mode>",
          "--reveal <start:end>",
          "--no-reveal",
          "--file <glob>",
          "--key <glob>",
          "--include <glob>",
          "--exclude <glob>",
          "--only <actions>",
          "--approve-deletes",
          "--no-approve-deletes",
          "--fail-on <condition>"
        ]
      },
      {
        "name": "vault apply",
        "owner": "native-cli",
        "args": ["<keyFile>"],
        "options": [
          "--plan <file>",
          "-y, --yes",
          "--sync-dir <dir>",
          "--vault-config <file>",
          "--no-auto-remap",
          "--allow-unmanaged",
          "--redaction <mode>",
          "--reveal <start:end>",
          "--no-reveal"
        ]
      },
      {
        "name": "vault sanitize",
        "owner": "native-cli",
        "args": ["<keyFile>"],
        "options": ["--excluded", "--dry-run", "-y, --yes", "--vault-config <file>"]
      },
      {
        "name": "vault prune",
        "owner": "native-cli",
        "args": ["<keyFile>"],
        "options": [
          "--file <path>",
          "--key <name>",
          "--older-than-days <days>",
          "--keep-recent <count>",
          "--no-preserve-latest",
          "--dry-run",
          "-y, --yes",
          "--vault-config <file>"
        ]
      }
    ],
    "exitStatus": {
      "success": 0,
      "ordinaryError": 1,
      "sortDrift": 1,
      "vaultFailOn": 2,
      "run": {
        "childExitCode": "passed through unchanged",
        "childSignal": 1,
        "note": "0.4.2 execa results have no numeric exitCode when the child is signal-terminated"
      }
    },
    "streams": {
      "payload": "stdout",
      "diagnostics": "stderr",
      "jsonErrors": "stdout as one JSON document"
    },
    "processSignals": {
      "childSelfSignalExitStatus": 1,
      "parentSIGINT": { "cliTermination": "SIGINT", "childCleanupSignal": "SIGTERM" },
      "parentSIGTERM": { "cliTermination": "SIGTERM", "childCleanupSignal": "SIGTERM" }
    }
  },
  "legacyConfigDiscovery": {
    "owner": "node-compat",
    "loader": "c12@3.3.4",
    "mainBaseName": "env-lane.config",
    "vaultDefaultBaseName": "env-lane.vault",
    "extensionPriority": [
      ".js",
      ".ts",
      ".mjs",
      ".cjs",
      ".mts",
      ".cts",
      ".json",
      ".jsonc",
      ".json5",
      ".yaml",
      ".yml",
      ".toml"
    ],
    "perExtensionLocationPriority": [
      "<root>/<base><extension>",
      "<root>/.config/<base><extension>",
      "<root>/.config/<base-without-.config><extension>"
    ],
    "disabledC12Sources": ["package.json", "dotenv", "rc file", "global rc"],
    "nativeMigration": {
      "rustFormats": [".json", ".yaml", ".yml"],
      "allOtherFormats": "compile or migrate in the Node compatibility package",
      "rule": "Rust must not embed c12, Jiti, or a JavaScript runtime"
    }
  },
  "defaults": {
    "mainConfig": {
      "selector": {
        "envKey": "ENV_BUILD",
        "defaultBuild": "local",
        "builds": [],
        "buildValidation": "warn",
        "forbidInDotenv": true
