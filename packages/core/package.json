{
  "name": "@env-lane/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core dotenv injection and workspace package resolution for env-lane.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "c12": "^3.3.4",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "find-up": "^8.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
