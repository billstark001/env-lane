{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@env-lane/core": ["./packages/core/src/index.ts"],
      "@env-lane/core/env-document": ["./packages/core/src/env-document.ts"],
      "@env-lane/vault": ["./packages/vault/src/index.ts"],
      "@env-lane/vault/cli": ["./packages/vault/src/cli/index.ts"]
    },
    "types": ["node"]
  }
}
