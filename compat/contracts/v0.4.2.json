      "dotenv": {
        "order": [".env", ".env.{build}"],
        "localBuildName": "local",
        "localOverrideFile": ".env.local",
        "requireOverride": false,
        "includeProcessEnv": true,
        "preserveBOM": true,
        "eol": "auto"
      },
      "vault": {
        "enabled": false,
        "disableUnsafeWarning": false,
        "configFile": "env-lane.vault"
      },
      "output": { "format": "text", "prefix": true }
