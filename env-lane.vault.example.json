{
  "envFiles": ["apps/api/.env", "apps/api/.env.production"],
  "outputDir": ".env-lane-vault",
  "outputFile": "store.dat",
  "trackDeletions": true,
  "disableUnsafeWarning": false,
  "exclude": [
    {
      "files": ["**/.env*"],
      "keys": ["*PRIVATE_KEY*", "*SECRET*", "DATABASE_URL"]
    }
  ],
  "sort": {
    "api": {
      "file": "apps/api/.env",
      "template": "apps/api/.env.example",
      "files": {
        "production": "apps/api/.env.production"
      }
    }
  }
}
