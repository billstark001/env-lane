{
  "name": "env-lane-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev": "pnpm --filter env-lane dev",
    "pack:dry-run": "pnpm -r --filter './packages/*' pack --dry-run",
    "publish:dry-run": "pnpm -r --filter './packages/*' publish --dry-run --access public --no-git-checks",
    "release": "pnpm check && pnpm build && pnpm -r --filter './packages/*' publish --access public --provenance",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
