{
  "name": "env-lane-workspace",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:build",
    "dev": "pnpm --filter env-lane dev",
    "pack:dry-run": "pnpm -r --filter './packages/*' pack --dry-run",
    "release:dry-run": "pnpm -r --filter './packages/*' publish --dry-run --access public --no-git-checks",
    "release": "pnpm check && pnpm -r --filter './packages/*' publish --access public",
    "test": "vitest run",
    "test:build": "pnpm build && node scripts/test-build.mjs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
