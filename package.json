{
  "name": "env-lane-workspace",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:build",
    "compat:classify": "node scripts/compat/classify-tests.mjs",
    "compat:fixtures": "node scripts/compat/run-fixtures.mjs",
    "compat:oracle:capture": "node scripts/compat/capture-oracle.mjs",
    "compat:oracle:verify": "node scripts/compat/verify-oracle.mjs",
    "compat:verify": "pnpm compat:oracle:verify && node scripts/compat/verify-contract.mjs && pnpm compat:fixtures && node scripts/compat/verify-process-signals.mjs",
    "dev": "pnpm --filter env-lane dev",
    "pack:dry-run": "pnpm -r --filter './packages/*' --filter '!@env-lane/compat-test' pack --dry-run",
    "release:dry-run": "pnpm -r --filter './packages/*' --filter '!@env-lane/compat-test' publish --dry-run --access public --no-git-checks",
    "release:verify": "node scripts/verify-release.mjs",
    "release": "pnpm release:verify && pnpm check && pnpm pack:dry-run && pnpm -r --filter './packages/*' --filter '!@env-lane/compat-test' publish --access public",
    "test": "vitest run && pnpm compat:verify",
    "test:build": "pnpm build && node scripts/test-build.mjs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
