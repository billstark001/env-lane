{
  "name": "env-lane-workspace",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev": "pnpm --filter env-lane dev",
    "pack:dry-run": "pnpm -r --filter './packages/*' pack --dry-run",
    "release:dry-run": "pnpm -r --filter './packages/*' publish --dry-run --access public --no-git-checks",
    "release": "pnpm check && pnpm build && pnpm -r --filter './packages/*' publish --access public",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25.9.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
