    "vaultConfig": {
      "outputDir": ".env-lane-vault",
      "outputFile": "store.dat",
      "trackDeletions": true,
      "autoRemapPaths": true,
      "allowUnmanaged": false,
      "restore": { "redaction": "full", "reveal": false, "promptLoop": false },
      "exclude": []
    }
