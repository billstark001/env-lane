{
  "name": "env-lane",
  "version": "0.5.0",
  "type": "module",
  "description": "CLI for env-lane dotenv injection and optional plugins.",
  "license": "MIT",
  "author": "billstark001",
  "homepage": "https://github.com/billstark001/env-lane#readme",
  "bugs": {
    "url": "https://github.com/billstark001/env-lane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billstark001/env-lane.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "dotenv",
    "env",
    "environment",
    "cli",
    "workspace",
    "pnpm"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "env-lane": "./dist/env-lane"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "scripts/install-native.cjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean && tsc -p tsconfig.build.json && node scripts/prepare-native-bin.mjs",
    "dev": "cargo run -p env-lane-cli --",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck",
    "postinstall": "node scripts/install-native.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@env-lane/native": "workspace:*",
    "@env-lane/core": "workspace:*"
  }
}
