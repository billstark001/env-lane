{
  "name": "env-lane",
  "version": "0.4.2",
  "type": "module",
  "description": "CLI for env-lane dotenv injection and optional development vault helpers.",
  "license": "MIT",
  "author": "billstark001",
  "homepage": "https://github.com/billstark001/env-lane#readme",
  "bugs": {
    "url": "https://github.com/billstark001/env-lane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billstark001/env-lane.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "dotenv",
    "env",
    "environment",
    "cli",
    "workspace",
    "pnpm"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "env-lane": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean && tsc -p tsconfig.build.json && tsup src/cli.ts --format esm --clean false",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@env-lane/core": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@env-lane/vault": "workspace:*"
  },
  "peerDependencies": {
    "@env-lane/vault": "^0.4.2"
  },
  "peerDependenciesMeta": {
    "@env-lane/vault": {
      "optional": true
    }
  }
}
