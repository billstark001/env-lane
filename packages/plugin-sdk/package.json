{
  "name": "@env-lane/plugin-sdk",
  "version": "0.5.0",
  "type": "module",
  "description": "Node.js runtime and types for env-lane JSON-RPC plugins",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./protocol.schema.json": "./protocol.schema.json",
    "./package.schema.json": "./package.schema.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "protocol.schema.json",
    "package.schema.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "node --check index.mjs"
  }
}
