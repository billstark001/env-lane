{
  "name": "@env-lane/vault",
  "version": "0.1.0",
  "type": "module",
  "description": "Unsafe-by-default development vault helpers for env-lane dotenv files.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@env-lane/core": "workspace:*",
    "dotenv": "^17.4.2",
    "picomatch": "^4.0.4",
    "zod": "^4.4.3"
  }
}
