  "persistence": {
    "owner": "shared-protocol",
    "vaultRecord": {
      "readVersions": [0, 1],
      "writeVersion": 1,
      "fields": ["version", "f", "k", "t", "op", "v"],
      "version0": "absolute file path and raw dotenv value",
      "version1": "config-relative portable path and effective value"
    },
    "ciphertext": {
      "algorithm": "AES-256-GCM",
      "layout": "base64(12-byte IV || 16-byte tag || ciphertext)",
      "kdf": "scrypt",
      "scrypt": { "N": 16384, "r": 8, "p": 1, "length": 32 },
      "saltUtf8": "env-store-v1-kdf-salt"
    },
    "syncState": {
      "readVersions": [0, 1],
      "writeVersion": 1,
      "fingerprint": "hmac-sha256",
      "hkdf": {
        "hash": "sha256",
        "saltUtf8": "env-lane-vault-sync-state-v1",
        "infoUtf8": "value-fingerprint",
        "length": 32
      }
    },
    "approvalDocument": {
      "version": 1,
      "requiredFields": ["version", "plan", "decisions"],
      "staleChecks": ["plan digest", "store digest", "entry id completeness"]
    }
  },
  "compatibilityExceptions": []
