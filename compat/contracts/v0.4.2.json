  "apiOwnership": {
    "rustCore": [
      "workspace discovery and target resolution",
      "dotenv document parse/render/patch and effective values",
      "resolve/check/policy/sync/sort application behavior",
      "redaction classification used by CLI and Vault previews",
      "Vault crypto, records, path mapping, sync, restore, history, locks, and atomic writes"
    ],
    "nativeCli": [
      "argv acceptance and run child boundary",
      "stdout/stderr rendering, JSON envelopes, exit status, and signals",
      "TTY Vault selection and non-interactive behavior"
    ],
    "nodeCompat": [
      "defineConfig/defineVaultConfig/defineEnvCheck/defineEnvSync identity and TypeScript inference",
      "c12 JavaScript/TypeScript/ESM/CommonJS config evaluation and cache compilation",
      "Promise, callback, Buffer, object, and error conversion at Node-API",
      "AsyncLocalStorage diagnostic isolation and Commander command registration",
      "ESM/CommonJS/declaration exports and all 0.4.x deprecated exports"
    ]
  },
  "deprecatedRuntimeExports": {
